# --- Server ---
# For local development keep HOST=127.0.0.1.
# On Railway, set HOST=0.0.0.0 and let Railway provide the PORT value.
HOST=127.0.0.1
PORT=8000

# --- Supabase Database ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-secret-key

# --- Email Options ---
# Option 1 (RECOMMENDED FOR RENDER): Brevo HTTP API (Port 443, never blocked by Render, free 300 emails/day)
# Get a free key in 1 min at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx

# Option 2: Resend HTTP API (Port 443, free at https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Option 3: Gmail SMTP (Works locally, but Render free tier blocks outbound SMTP ports 25/465/587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=shadowchat.sender@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- OTP / Security policy ---
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=10

# --- Invitations / Rooms ---
INVITATION_EXPIRY_MINUTES=5
RECONNECT_GRACE_SECONDS=30

# --- Client ---
SERVER_HTTP_URL=http://127.0.0.1:8000
SERVER_WS_URL=ws://127.0.0.1:8000/ws
